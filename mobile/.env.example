# Same Supabase project as the web app (Settings > API). These values are public by design.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects: use the anon key instead
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional: your deployed web app, used for the "transcript (PDF)" button
EXPO_PUBLIC_WEB_URL=https://ardoise.example.cm
