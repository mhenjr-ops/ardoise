{
  "expo": {
    "name": "Ardoise",
    "slug": "ardoise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ardoise",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "cm.ardoise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ardoise uses the camera so you can photograph handwritten work and submit it.",
        "NSPhotoLibraryUsageDescription": "Ardoise lets you pick a photo of your work to submit it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3B36",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cm.ardoise.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Ardoise",
      "themeColor": "#1F3B36",
      "backgroundColor": "#F4EDE1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3B36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ardoise lets you pick a photo of your work to submit it.",
          "cameraPermission": "Ardoise uses the camera so you can photograph handwritten work and submit it."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1F3B36",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "6014f204-86a6-4ce4-8bdf-c1d6098132fd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6014f204-86a6-4ce4-8bdf-c1d6098132fd"
    }
  }
}
