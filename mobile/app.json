{
  "expo": {
    "name": "Ardoise",
    "slug": "ardoise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ardoise",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "cm.ardoise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ardoise uses the camera so you can photograph handwritten work and submit it.",
        "NSPhotoLibraryUsageDescription": "Ardoise lets you pick a photo of your work to submit it."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16202C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cm.ardoise.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16202C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ardoise lets you pick a photo of your work to submit it.",
          "cameraPermission": "Ardoise uses the camera so you can photograph handwritten work and submit it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}